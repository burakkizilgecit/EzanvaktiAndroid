{
  "expo": {
    "name": "Ezan Vakti",
    "slug": "islamicibadet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "islamicibadet",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.islamicibadet.app",
      "versionCode": 47,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC__fpddD5_gO__BBU54BIJZWWMU-ACkys"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#0B0F1A",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Namaz vakitlerini ve kıble yönünü hesaplamak için konumunuz gereklidir.",
          "locationWhenInUsePermission": "Namaz vakitlerini ve kıble yönünü hesaplamak için konumunuz gereklidir."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C8A853",
          "sounds": [
            "./assets/sounds/ezan.mp3",
            "./assets/sounds/ilahi.mp3"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F1A",
          "dark": {
            "backgroundColor": "#0B0F1A"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildFeatures": {
              "buildConfig": true
            },
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withBuildConfig",
      "./plugins/withRemovePermissions",
      "./plugins/withRingtoneQuery",
      "expo-background-task",
      "./plugins/withPrayerWidgets",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "googleMapsApiKey": "AIzaSyC__fpddD5_gO__BBU54BIJZWWMU-ACkys",
      "eas": {
        "projectId": "12dcac4c-e5c0-400c-b10b-d8d14e699bf8"
      }
    }
  }
}
